# Server port (default: 3001)
PORT=3001

# Persistent receipt counter storage.
# Locally the counter is stored in data/receipt-counter.json (no config needed).
#
# On Vercel the filesystem is read-only, so connect a Vercel KV / Upstash Redis
# store and Vercel will inject these automatically. When present, the receipt
# counter is read from / written to KV instead of the JSON file.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
