# Server port (default: 3001)
PORT=3001

# --- Persistent storage (receipt counter + enquiries + subscribers) ---
# Locally these are stored in JSON files (no config needed).
# On Vercel the filesystem is read-only, so connect a Vercel KV / Upstash Redis
# store. When present, data is read from / written to KV instead of files.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# (Upstash marketplace also works via UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN)

# --- Enquiries admin page (/enquiries) ---
# Required to view stored enquiries. Then open /enquiries and enter this key
# (or visit /enquiries?key=YOUR_SECRET).
ENQUIRIES_TOKEN=

# --- Email notifications for new contact enquiries ---
# SMTP of the sending mailbox (chaitra@unionrealityandconstructions.com).
# If unset, enquiries are still saved but no email is sent.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=chaitra@unionrealityandconstructions.com
SMTP_PASS=
MAIL_FROM=chaitra@unionrealityandconstructions.com
MAIL_TO=sales@unionrealityandconstructions.com
